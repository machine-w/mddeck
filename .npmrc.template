# mddeck — npm publish configuration
#
# This file is a TEMPLATE. scripts/publish.sh will render it to .npmrc
# (gitignored) and inject the real token + provenance setting.
#
# USAGE:
#   export NPM_TOKEN="npm_xxxxxxxxxxxxx"
#   npm run publish:all
# OR:
#   NPM_TOKEN="npm_xxxxxxxxxxxxx" bash scripts/publish.sh
#
# DO NOT COMMIT A FILE WITH A REAL TOKEN.

# npm registry authentication
//registry.npmjs.org/:_authToken=${NPM_TOKEN}

# provenance is injected by scripts/publish.sh based on whether
# we're in a CI environment (which has OIDC) or not.
# (Empty here — see the PROVENANCE_FLAG logic in publish.sh.)
# provenance=true

# Save exact versions in package-lock.json on `npm install`
save-exact=true

# Always include the @machine-w/* scope in `npm install @machine-w/...` (default in npm 7+)
@machine-w:registry=https://registry.npmjs.org/

